<!DOCTYPE html>
<html>
  <head>
    <title>Tech University</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <nav class="bg-blue-600 text-white shadow-md">
      <div class="container mx-auto px-4 py-2 flex justify-between items-center">

        <a href="#" class="text-2xl font-semibold hover:text-blue-200 transition duration-200">
          Tech University
        </a>


        <ul class="hidden md:flex space-x-6 items-center">
          <li><a href="#" class="hover:text-blue-200 transition duration-200">Cursos</a></li>
          <li><a href="#" class="hover:text-blue-200 transition duration-200">Inscrições</a></li>
          <li><a href="#" class="hover:text-blue-200 transition duration-200">Minha conta</a></li>
          <li>
            <a href="#!" class="hover:text-blue-200 transition duration-200" aria-label="Perfil">

              <i class="material-icons text-2xl">menu</i>
            </a>
          </li>
        </ul>


        <button class="md:hidden text-white focus:outline-none">
          <i class="material-icons text-3xl">menu</i>
        </button>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>

</html>
